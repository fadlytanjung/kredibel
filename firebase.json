{
  "firestore": {
    "rules": "contracts/firestore.rules",
    "indexes": "contracts/firestore.indexes.json"
  },
  "hosting": {
    "site": "kredibel-app",
    "public": "frontend/dist",
    "cleanUrls": true,
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "kredibel-web",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/docs",
        "run": {
          "serviceId": "kredibel-web",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/openapi.json",
        "run": {
          "serviceId": "kredibel-web",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080,
      "host": "0.0.0.0"
    },
    "ui": {
      "enabled": true,
      "port": 4000,
      "host": "0.0.0.0"
    }
  }
}

# Kredibel — Environment Configuration Template
# Copy to .env for local development: cp .env.example .env

# ==============================================================================
# Application Mode & Core Settings
# ==============================================================================
APP_ROLE=all
APP_VERSION=dev
LOG_LEVEL=INFO
DATA_CLASS=synthetic
SIGNUP_MODE=open
MAX_WORKSPACES=15
RUNS_ENABLED=true
RUN_QUOTA_PER_ORG_PER_DAY=80

# ==============================================================================
# Google Cloud Platform (Project: cloud-hack2skill)
# ==============================================================================
GOOGLE_CLOUD_PROJECT=cloud-hack2skill
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
REGION=asia-southeast1

# Storage Buckets
DOCS_BUCKET=cloud-hack2skill-kredibel-docs
BACKUPS_BUCKET=cloud-hack2skill-kredibel-backups
AGENT_CONTENT_BUCKET=cloud-hack2skill-kredibel-agent-content

# ==============================================================================
# Local Firestore Emulator (Docker / Firebase CLI)
# Set FIRESTORE_EMULATOR_HOST to talk to the local emulator.
# Leave empty to talk directly to Cloud Firestore via gcloud ADC.
# ==============================================================================
FIRESTORE_EMULATOR_HOST=localhost:8080

# ==============================================================================
# Task Queue & Worker Communication
# ==============================================================================
# inline = execute in background asyncio thread (ideal for local development)
# cloud  = push tasks to Google Cloud Tasks
TASK_QUEUE_MODE=inline
TASKS_LOCATION=asia-southeast1
TASKS_QUEUE_DOCUMENTS=kredibel-documents
TASKS_QUEUE_MONTHS=kredibel-months
MONTH_RUN_DELAY_SECONDS=20
WORKER_URL=http://localhost:8000
TASKS_INVOKER_SA=kredibel-tasks-invoker@cloud-hack2skill.iam.gserviceaccount.com

# ==============================================================================
# Document AI Processors (Location: us)
# ==============================================================================
DOCAI_LOCATION=us
DOCAI_OCR_PROCESSOR_ID=
DOCAI_OCR_VERSION=
DOCAI_FORM_PROCESSOR_ID=
DOCAI_FORM_VERSION=
DOCAI_INVOICE_PROCESSOR_ID=
DOCAI_INVOICE_VERSION=

# ==============================================================================
# Extraction & Processing Parameters
# ==============================================================================
EXTRACTION_MODE=adaptive
EXTRACTION_ESCALATION=off
ESCALATION_MAX_PAGES_PER_MONTH=30
READ_MEDIA_RESOLUTION=high
PAGE_CONCURRENCY=6
EXTRACTION_CACHE=on
PREFILL_ON_UPLOAD=off
EXPLAINER_MAX_ATTEMPTS=2
DOCUMENT_RUN_BUDGET_SECONDS=600
MONTH_RUN_BUDGET_SECONDS=120

# ==============================================================================
# Model Configurations (Config-driven, no literals in code)
# ==============================================================================
MODEL_FAST=gemini-3.8-flash
MODEL_LITE=gemini-flash-lite-latest
MODEL_EMBEDDING=gemini-embedding-001
EVAL_JUDGE_MODEL=gemini-3.8-flash

# Model Armor (P1)
MODEL_ARMOR_LOCATION=asia-southeast1
MODEL_ARMOR_TEMPLATE=kredibel-docs

# Assistant Memory & Sessions (P1)
MEMORY_BANK_ID=
AGENT_SESSIONS_ID=
ASSISTANT_LOCATION=asia-southeast1
ASSISTANT_MEMORY=off

# ==============================================================================
# Policy & Contract File Paths
# ==============================================================================
PLANS_FILE=contracts/plans.v1.yaml
POLICY_DIR=contracts/policy
CATEGORIES_FILE=contracts/policy/categories.v1.yaml
LEARNING_FILE=contracts/policy/learning.v1.yaml

# ==============================================================================
# Observability & Data Capture
# ==============================================================================
AI_CONTENT_CAPTURE=off
ADK_CAPTURE_MESSAGE_CONTENT_IN_SPANS=false
ANALYTICS_DATASET=kredibel_agent_analytics

# ==============================================================================
# Migrations
# ==============================================================================
MIGRATION_MAX_OPS_PER_SEC=500
MIGRATION_PAGE_SIZE=300
MIGRATION_EXPORT_BEFORE_RUN=false

# ==============================================================================
# Feature Flags
# ==============================================================================
FEATURE_MODEL_ARMOR=false
FEATURE_VISUAL_FORENSICS=false
FEATURE_REVISION_DIFF=false
FEATURE_ASSISTANT=false
FEATURE_ROLES=false
FEATURE_RUN_GRAPH=false
FEATURE_SIGN_OFF=false
FEATURE_LABELS=false
FEATURE_AGENT_ANALYTICS=false
FEATURE_DATASET_EXPORT=false

# ==============================================================================
# Frontend Environment Variables (Build-time, public bundle)
# ==============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=cloud-hack2skill.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cloud-hack2skill
VITE_FIREBASE_APP_ID=
VITE_APP_VERSION=dev

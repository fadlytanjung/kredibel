{
  "$description": "Kredibel design tokens, W3C Design Tokens (DTCG) format. Single source of truth for colour, type, space, shape, depth, motion and layout. Edit here, run `make tokens`, never hand-edit generated CSS. Groups: core (raw values), light and dark (semantic roles that components use), plus non-colour scales. See docs/12-design-system.md.",
  "$extensions": {
    "kredibel.version": "2.2.0",
    "kredibel.concept": "Two readings: every figure is read twice and the interface shows whether the readings agree. 2.1: friendlier radii, money-flow colours, a labelled sidebar; loan grades removed. 2.2: cash-flow activity colours and chart grid.",
    "kredibel.contrastPairs": [
      ["light.color.text.default", "light.color.bg.canvas", 7.0],
      ["light.color.text.default", "light.color.bg.surface", 7.0],
      ["light.color.text.muted", "light.color.bg.surface", 4.5],
      ["light.color.text.muted", "light.color.bg.canvas", 4.5],
      ["light.color.text.subtle", "light.color.bg.surface", 4.5],
      ["light.color.text.on-brand", "light.color.brand.default", 4.5],
      ["light.color.brand.default", "light.color.bg.surface", 4.5],
      ["light.color.brand.default", "light.color.brand.soft", 4.5],
      ["light.color.evidence.text", "light.color.evidence.soft", 4.5],
      ["light.color.evidence.text", "light.color.bg.surface", 4.5],
      ["light.color.severity.critical.fg", "light.color.severity.critical.bg", 4.5],
      ["light.color.severity.high.fg", "light.color.severity.high.bg", 4.5],
      ["light.color.severity.medium.fg", "light.color.severity.medium.bg", 4.5],
      ["light.color.severity.low.fg", "light.color.severity.low.bg", 4.5],
      ["light.color.severity.info.fg", "light.color.severity.info.bg", 4.5],
      ["light.color.verdict.clean.fg", "light.color.verdict.clean.bg", 4.5],
      ["light.color.severity.critical.fg", "light.color.bg.surface", 4.5],
      ["light.color.border.strong", "light.color.bg.surface", 3.0],
      ["light.color.focus.ring", "light.color.bg.surface", 3.0],
      ["light.color.focus.ring", "light.color.bg.canvas", 3.0],
      ["dark.color.text.default", "dark.color.bg.canvas", 7.0],
      ["dark.color.text.muted", "dark.color.bg.surface", 4.5],
      ["dark.color.text.on-brand", "dark.color.brand.default", 4.5],
      ["dark.color.severity.critical.fg", "dark.color.severity.critical.bg", 4.5]
    ]
  },

  "core": {
    "$description": "Raw palette. Components never use these directly; they use light/dark roles.",
    "color": {
      "$type": "color",
      "white": { "$value": "#FFFFFF" },
      "slate": {
        "25":  { "$value": "#F8F9FA" },
        "50":  { "$value": "#F2F4F5" },
        "100": { "$value": "#E8ECEE" },
        "200": { "$value": "#DCE1E5" },
        "300": { "$value": "#B9C2CA" },
        "400": { "$value": "#828E99" },
        "500": { "$value": "#6B7782" },
        "600": { "$value": "#56636F" },
        "700": { "$value": "#3B4652" },
        "800": { "$value": "#26303A" },
        "850": { "$value": "#1C252E" },
        "900": { "$value": "#16212B" },
        "950": { "$value": "#0F171F" }
      },
      "ledger": {
        "$description": "Banker's-lamp green: brand, primary actions, agreed values.",
        "50":  { "$value": "#E7F2EE" },
        "100": { "$value": "#CFE6DD" },
        "200": { "$value": "#9FE0C6", "$description": "Mint: the check in the logo; accents on brand and ink surfaces" },
        "300": { "$value": "#7DB9A2" },
        "500": { "$value": "#2E8B6A" },
        "600": { "$value": "#17714F" },
        "700": { "$value": "#0E5A47" },
        "800": { "$value": "#0A4738" },
        "900": { "$value": "#06302A" }
      },
      "lamp": {
        "$description": "Evidence violet: the highlight on a page, citations, 'look here'. Never a severity.",
        "50":  { "$value": "#F1EEFF" },
        "100": { "$value": "#E2DBFF" },
        "300": { "$value": "#A99BFF" },
        "500": { "$value": "#6B4EFF" },
        "600": { "$value": "#5A3DF0" },
        "700": { "$value": "#4A2FCC" }
      },
      "red":    { "50": { "$value": "#FDECEA" }, "100": { "$value": "#F9D3CE" }, "700": { "$value": "#B42318" }, "300": { "$value": "#F0857A" } },
      "orange": { "50": { "$value": "#FEF0E1" }, "700": { "$value": "#A6420A" }, "300": { "$value": "#F2A766" } },
      "amber":  { "50": { "$value": "#FFF5D6" }, "700": { "$value": "#7F5A00" }, "300": { "$value": "#E8C25A" } },
      "blue":   { "50": { "$value": "#E8EFF7" }, "700": { "$value": "#2F5C93" }, "300": { "$value": "#8FB1DA" } },
      "green":  { "50": { "$value": "#E3F3EA" }, "700": { "$value": "#17663F" }, "300": { "$value": "#7CC79E" } }
    }
  },

  "light": {
    "$description": "Default theme. Semantic roles; component code uses only these (as CSS variables).",
    "color": {
      "$type": "color",
      "bg": {
        "canvas":  { "$value": "{core.color.slate.50}",  "$description": "App background" },
        "surface": { "$value": "{core.color.white}",     "$description": "Panels, tables, sheets" },
        "sunken":  { "$value": "{core.color.slate.100}", "$description": "Wells, table headers, hovered rows" },
        "raised":  { "$value": "{core.color.white}",     "$description": "The one elevated surface on a screen (review fix panel, sheets)" },
        "inverse": { "$value": "{core.color.slate.900}", "$description": "Toasts, the onboarding brand panel" }
      },
      "border": {
        "default": { "$value": "{core.color.slate.200}" },
        "strong":  { "$value": "{core.color.slate.400}", "$description": "Inputs, active tabs: 3:1 against surfaces" }
      },
      "text": {
        "default":    { "$value": "{core.color.slate.900}" },
        "muted":      { "$value": "{core.color.slate.600}" },
        "subtle":     { "$value": "{core.color.slate.500}" },
        "on-brand":   { "$value": "{core.color.white}" },
        "on-inverse": { "$value": "{core.color.slate.50}" }
      },
      "brand": {
        "default": { "$value": "{core.color.ledger.700}" },
        "hover":   { "$value": "{core.color.ledger.800}" },
        "soft":    { "$value": "{core.color.ledger.50}" },
        "line":    { "$value": "{core.color.ledger.500}" },
        "accent":  { "$value": "{core.color.ledger.200}", "$description": "Mint, only on brand or inverse surfaces (logo check, active marks)" }
      },
      "evidence": {
        "line": { "$value": "{core.color.lamp.500}", "$description": "Box outline on a page, citation underline" },
        "fill": { "$value": "#6B4EFF29",             "$description": "16% lamp fill over a page region" },
        "soft": { "$value": "{core.color.lamp.50}" },
        "text": { "$value": "{core.color.lamp.700}" }
      },
      "reading": {
        "$description": "Provenance marks under figures (shape carries meaning, colour supports it).",
        "agreed":        { "$value": "{core.color.ledger.600}", "$description": "Double rule: two readings agree" },
        "single-source": { "$value": "{core.color.slate.400}",  "$description": "Dotted rule: one reading only" },
        "conflict":      { "$value": "{core.color.red.700}",    "$description": "Wavy rule: readings disagree" }
      },
      "severity": {
        "critical": { "fg": { "$value": "{core.color.red.700}" },    "bg": { "$value": "{core.color.red.50}" },    "line": { "$value": "{core.color.red.300}" } },
        "high":     { "fg": { "$value": "{core.color.orange.700}" }, "bg": { "$value": "{core.color.orange.50}" }, "line": { "$value": "{core.color.orange.300}" } },
        "medium":   { "fg": { "$value": "{core.color.amber.700}" },  "bg": { "$value": "{core.color.amber.50}" },  "line": { "$value": "{core.color.amber.300}" } },
        "low":      { "fg": { "$value": "{core.color.blue.700}" },   "bg": { "$value": "{core.color.blue.50}" },   "line": { "$value": "{core.color.blue.300}" } },
        "info":     { "fg": { "$value": "{core.color.slate.700}" },  "bg": { "$value": "{core.color.slate.100}" }, "line": { "$value": "{core.color.slate.300}" } }
      },
      "verdict": {
        "clean":        { "fg": { "$value": "{core.color.green.700}" },  "bg": { "$value": "{core.color.green.50}" } },
        "suspicious":   { "fg": { "$value": "{core.color.amber.700}" },  "bg": { "$value": "{core.color.amber.50}" } },
        "tampered":     { "fg": { "$value": "{core.color.red.700}" },    "bg": { "$value": "{core.color.red.50}" } },
        "unverifiable": { "fg": { "$value": "{core.color.slate.700}" },  "bg": { "$value": "{core.color.slate.100}" } }
      },
      "chart": {
        "inflow":   { "$value": "{core.color.ledger.500}" },
        "outflow":  { "$value": "{core.color.slate.300}" },
        "net":      { "$value": "{core.color.slate.900}" },
        "balance":  { "$value": "{core.color.slate.600}", "$description": "Balance line, dashed" },
        "negative": { "$value": "{core.color.red.700}" },
        "flow-in":  { "$value": "#7DB9A28C", "$description": "Money-flow band into an account (55% ledger 300)" },
        "flow-out": { "$value": "#B9C2CA99", "$description": "Money-flow band out of an account (60% slate 300)" },
        "flow-hover": { "$value": "#2E8B6A8C", "$description": "Band under the pointer or keyboard focus" },
        "node-source": { "$value": "{core.color.ledger.500}" },
        "node-account": { "$value": "{core.color.ledger.700}" },
        "node-use": { "$value": "{core.color.slate.600}" },
        "kept": { "$value": "{core.color.ledger.200}", "$description": "Kept in the account" },
        "taken": { "$value": "{core.color.amber.300}", "$description": "Taken from the balance" },
        "operating": { "$value": "#56636F", "$description": "Cash-flow activity: operating (statement charts)" },
        "investing": { "$value": "#3E6E8E", "$description": "Cash-flow activity: investing" },
        "financing": { "$value": "#8C5E9E", "$description": "Cash-flow activity: financing" },
        "grid": { "$value": "#DCE1E5", "$description": "Chart gridlines and axes" }
      },
      "focus": {
        "ring": { "$value": "{core.color.lamp.600}", "$description": "2px ring, 2px offset; violet so it never reads as a status" }
      },
      "scrim": { "$value": "#0F171F8C", "$description": "Behind drawers and sheets (55%)" }
    }
  },

  "dark": {
    "$description": "Dark theme (P2). Same role names as light; only values change.",
    "color": {
      "$type": "color",
      "bg": {
        "canvas":  { "$value": "{core.color.slate.950}" },
        "surface": { "$value": "{core.color.slate.850}" },
        "sunken":  { "$value": "{core.color.slate.900}" },
        "raised":  { "$value": "{core.color.slate.800}" },
        "inverse": { "$value": "{core.color.slate.50}" }
      },
      "border": {
        "default": { "$value": "{core.color.slate.700}" },
        "strong":  { "$value": "{core.color.slate.500}" }
      },
      "text": {
        "default":    { "$value": "{core.color.slate.50}" },
        "muted":      { "$value": "{core.color.slate.300}" },
        "subtle":     { "$value": "{core.color.slate.400}" },
        "on-brand":   { "$value": "{core.color.slate.950}" },
        "on-inverse": { "$value": "{core.color.slate.900}" }
      },
      "brand": {
        "default": { "$value": "{core.color.ledger.300}" },
        "hover":   { "$value": "{core.color.ledger.100}" },
        "soft":    { "$value": "#7DB9A229" },
        "line":    { "$value": "{core.color.ledger.300}" },
        "accent":  { "$value": "{core.color.ledger.200}" }
      },
      "evidence": {
        "line": { "$value": "{core.color.lamp.300}" },
        "fill": { "$value": "#A99BFF33" },
        "soft": { "$value": "#A99BFF26" },
        "text": { "$value": "{core.color.lamp.100}" }
      },
      "reading": {
        "agreed":        { "$value": "{core.color.ledger.300}" },
        "single-source": { "$value": "{core.color.slate.400}" },
        "conflict":      { "$value": "{core.color.red.300}" }
      },
      "severity": {
        "critical": { "fg": { "$value": "{core.color.red.300}" },    "bg": { "$value": "#B4231833" }, "line": { "$value": "{core.color.red.300}" } },
        "high":     { "fg": { "$value": "{core.color.orange.300}" }, "bg": { "$value": "#A6420A33" }, "line": { "$value": "{core.color.orange.300}" } },
        "medium":   { "fg": { "$value": "{core.color.amber.300}" },  "bg": { "$value": "#7F5A0033" }, "line": { "$value": "{core.color.amber.300}" } },
        "low":      { "fg": { "$value": "{core.color.blue.300}" },   "bg": { "$value": "#2F5C9333" }, "line": { "$value": "{core.color.blue.300}" } },
        "info":     { "fg": { "$value": "{core.color.slate.300}" },  "bg": { "$value": "{core.color.slate.800}" }, "line": { "$value": "{core.color.slate.500}" } }
      },
      "verdict": {
        "clean":        { "fg": { "$value": "{core.color.green.300}" }, "bg": { "$value": "#17663F33" } },
        "suspicious":   { "fg": { "$value": "{core.color.amber.300}" }, "bg": { "$value": "#7F5A0033" } },
        "tampered":     { "fg": { "$value": "{core.color.red.300}" },   "bg": { "$value": "#B4231833" } },
        "unverifiable": { "fg": { "$value": "{core.color.slate.300}" }, "bg": { "$value": "{core.color.slate.800}" } }
      },
      "chart": {
        "inflow":   { "$value": "{core.color.ledger.300}" },
        "outflow":  { "$value": "{core.color.slate.600}" },
        "net":      { "$value": "{core.color.slate.50}" },
        "balance":  { "$value": "{core.color.slate.300}" },
        "negative": { "$value": "{core.color.red.300}" },
        "flow-in":  { "$value": "#7DB9A266" },
        "flow-out": { "$value": "#56636F99" },
        "flow-hover": { "$value": "#9FE0C64D" },
        "node-source": { "$value": "{core.color.ledger.300}" },
        "node-account": { "$value": "{core.color.ledger.200}" },
        "node-use": { "$value": "{core.color.slate.300}" },
        "kept": { "$value": "{core.color.ledger.200}" },
        "taken": { "$value": "{core.color.amber.300}" },
        "operating": { "$value": "#B9C2CA" },
        "investing": { "$value": "#8FB6D1" },
        "financing": { "$value": "#C9A8D6" },
        "grid": { "$value": "#2B3640" }
      },
      "focus": { "ring": { "$value": "{core.color.lamp.300}" } },
      "scrim": { "$value": "#000000A6" }
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Archivo Variable", "Archivo", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "One family for everything; personality comes from the width axis" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular":  { "$value": 400 },
      "medium":   { "$value": 520 },
      "semibold": { "$value": 620 },
      "bold":     { "$value": 720 }
    },
    "stretch": {
      "$type": "number",
      "$description": "font-stretch percentages (Archivo wdth axis 62-125)",
      "code":    { "$value": 80,  "$description": "Codes and references: INV/SCR/2026/03/0009, A01" },
      "normal":  { "$value": 100 },
      "figure":  { "$value": 108, "$description": "Money and ratios" },
      "display": { "$value": 116, "$description": "Hero figures and page titles" }
    }
  },

  "typography": {
    "$type": "typography",
    "$description": "Composite styles. Size and line height in px; mobile sizes in $extensions where they differ.",
    "figure-xl": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "40px", "lineHeight": "44px", "fontWeight": 640, "letterSpacing": "-0.01em" }, "$extensions": { "kredibel.stretch": 116, "kredibel.numeric": "tabular-nums lining-nums", "kredibel.compact": { "fontSize": "32px", "lineHeight": "36px" } } },
    "figure-lg": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "26px", "lineHeight": "32px", "fontWeight": 620, "letterSpacing": "-0.005em" }, "$extensions": { "kredibel.stretch": 108, "kredibel.numeric": "tabular-nums lining-nums", "kredibel.compact": { "fontSize": "22px", "lineHeight": "28px" } } },
    "figure-md": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "17px", "lineHeight": "24px", "fontWeight": 600, "letterSpacing": "0" }, "$extensions": { "kredibel.stretch": 108, "kredibel.numeric": "tabular-nums lining-nums" } },
    "title":     { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "34px", "lineHeight": "40px", "fontWeight": 680, "letterSpacing": "-0.015em" }, "$extensions": { "kredibel.stretch": 116, "kredibel.compact": { "fontSize": "26px", "lineHeight": "32px" } } },
    "h1":        { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "24px", "lineHeight": "30px", "fontWeight": 640, "letterSpacing": "-0.01em" }, "$extensions": { "kredibel.stretch": 108 } },
    "h2":        { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "18px", "lineHeight": "26px", "fontWeight": 620, "letterSpacing": "-0.005em" }, "$extensions": { "kredibel.stretch": 100 } },
    "h3":        { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "15px", "lineHeight": "22px", "fontWeight": 620, "letterSpacing": "0" }, "$extensions": { "kredibel.stretch": 100 } },
    "body":      { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "15px", "lineHeight": "22px", "fontWeight": 400, "letterSpacing": "0" }, "$extensions": { "kredibel.stretch": 100, "kredibel.compact": { "fontSize": "16px", "lineHeight": "24px" } } },
    "body-sm":   { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 400, "letterSpacing": "0.005em" }, "$extensions": { "kredibel.stretch": 100, "kredibel.compact": { "fontSize": "14px", "lineHeight": "20px" } } },
    "label":     { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 560, "letterSpacing": "0.01em" }, "$extensions": { "kredibel.stretch": 100 } },
    "code":      { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px", "lineHeight": "18px", "fontWeight": 640, "letterSpacing": "0.02em" }, "$extensions": { "kredibel.stretch": 80, "kredibel.numeric": "tabular-nums" } },
    "page-print":{ "$value": { "fontFamily": "{font.family.sans}", "fontSize": "11px", "lineHeight": "16px", "fontWeight": 400, "letterSpacing": "0" }, "$extensions": { "kredibel.stretch": 100, "kredibel.note": "Only for drawing a document page preview in mocks" } }
  },

  "space": {
    "$type": "dimension",
    "0":  { "$value": "0px" },
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "20px" },
    "6":  { "$value": "24px" },
    "8":  { "$value": "32px" },
    "10": { "$value": "40px" },
    "12": { "$value": "48px" },
    "16": { "$value": "64px" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "Radius follows hierarchy: small things are tighter, containers softer.",
    "xs":   { "$value": "6px",   "$description": "Badges, code tags" },
    "sm":   { "$value": "10px",  "$description": "Buttons, inputs, list rows" },
    "md":   { "$value": "16px",  "$description": "Panels and sections" },
    "lg":   { "$value": "24px",  "$description": "Sheets, drawers, dialogs (top corners on mobile), the money-flow panel" },
    "full": { "$value": "999px", "$description": "Pills, avatars, segmented control" }
  },

  "shadow": {
    "$type": "shadow",
    "raised":  { "$value": [{ "color": "#16212B14", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }, { "color": "#16212B1F", "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-8px" }], "$description": "The one raised surface on a screen: the review fix panel, the floating upload button" },
    "overlay": { "$value": [{ "color": "#16212B29", "offsetX": "0px", "offsetY": "24px", "blur": "48px", "spread": "-12px" }], "$description": "Drawers, sheets, popovers, dialogs" }
  },

  "border-width": {
    "$type": "dimension",
    "hairline": { "$value": "1px" },
    "strong":   { "$value": "2px" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": "80ms" },
      "fast":    { "$value": "140ms", "$description": "Hover, press, toggles" },
      "base":    { "$value": "220ms", "$description": "Tabs, accordions, sheets" },
      "slow":    { "$value": "320ms", "$description": "Drawers" },
      "sweep":   { "$value": "720ms", "$description": "The lamp sweep across an evidence box, once" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard":   { "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$value": [0.3, 0, 0, 1] },
      "exit":       { "$value": [0.3, 0, 1, 1] }
    }
  },

  "layout": {
    "$type": "dimension",
    "breakpoint": {
      "$description": "Window size classes. compact < 600 <= medium < 840 <= expanded < 1200 <= large",
      "medium":   { "$value": "600px" },
      "expanded": { "$value": "840px" },
      "large":    { "$value": "1200px" },
      "wide":     { "$value": "1600px" }
    },
    "touch-target":   { "$value": "44px", "$description": "Minimum hit area on coarse pointers" },
    "control-height": { "sm": { "$value": "32px" }, "md": { "$value": "40px" }, "lg": { "$value": "48px" } },
    "rail-width":     { "$value": "88px" },
    "sidebar-width":  { "$value": "248px", "$description": "Labelled sidebar from the large window class" },
    "panel-width":    { "$value": "440px", "$description": "Review fix panel and side sheets" },
    "content-max":    { "$value": "1280px" },
    "prose-max":      { "$value": "72ch" },
    "gutter":         { "compact": { "$value": "16px" }, "medium": { "$value": "24px" }, "expanded": { "$value": "32px" } },
    "drawer":         { "md": { "$value": "480px" }, "lg": { "$value": "960px" }, "xl": { "$value": "1200px" } }
  },

  "z": {
    "$type": "number",
    "sticky":  { "$value": 10 },
    "header":  { "$value": 20 },
    "nav":     { "$value": 30 },
    "sheet":   { "$value": 40 },
    "dialog":  { "$value": 50 },
    "toast":   { "$value": 60 }
  }
}
